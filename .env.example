# ===== Base de datos (Supabase Postgres) =====
# Conexión Postgres (pooler) — servidor
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Conexión directa para migraciones de Drizzle
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# ===== Sesión propia (cookie firmada) =====
# Secreto largo (>= 32 caracteres) para firmar la cookie de sesión HTTP-only.
# Generar con: openssl rand -base64 48
AUTH_SECRET=genera-un-secreto-largo-de-al-menos-32-caracteres
