# ===== Supabase =====
# Conexión Postgres (pooler) — servidor
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Conexión directa para migraciones de Drizzle
DIRECT_URL=postgresql://postgres:password@host:5432/postgres
# URL pública del proyecto Supabase (segura en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Clave pública anónima (segura en cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ⚠️ SOLO servidor. NUNCA exponer en cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key